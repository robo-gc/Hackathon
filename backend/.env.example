# Obtén tu API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modelo recomendado (Gemini 4 daily driver con soporte para Interactions API y Google Search)
GEMINI_MODEL=gemini-4-hydrogen

# Intervalo de actualización de caché en segundos (600 s = 10 minutos)
ENVIRONMENT_CACHE_TTL_SECONDS=600
